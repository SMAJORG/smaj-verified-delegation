META_API_KEY=
# Set ONLY to an exact ID returned by GET https://api.meta.ai/v1/models for this key.
META_MODEL=muse-spark-1.3
SMAJ_JOBS_API_URL=https://smajpihub.onrender.com/jobs/jobs
SMAJ_DELEGATION_DB_PATH=./data/smaj-verified-delegation.sqlite

# SMAJ PI HUB single sign-on (ai.smajpihub.com)
# Canonical website/SSO URL. Render also supplies RENDER_EXTERNAL_URL automatically;
# both exact origins are accepted for browser mutations. Never use a wildcard.
SMAJ_AI_PUBLIC_URL=https://ai.smajpihub.com
PIHUB_API_BASE_URL=https://smajpihub.onrender.com
SMAJ_AI_CLIENT_ID=smaj-ai
SMAJ_AI_CLIENT_SECRET=
SMAJ_AI_SSO_SECRET=
SMAJ_AI_SESSION_SECRET=
# Read-only SMAJ Store catalog
SMAJ_STORE_API_URL=https://smajpihub.onrender.com/marketplace/products
SMAJ_PRODUCTION_WRITES_ENABLED=false
SMAJ_REAL_PI_PAYMENTS_ENABLED=false

# Catalog allowlisted HTTPS origin and public published creator metadata
SMAJ_HUB_API_ORIGIN=https://smajpihub.onrender.com
SMAJ_STREAM_API_URL=https://smajpihub.onrender.com/stream/creator-content

# Embedded Hub AI: use the same random secret (at least 32 characters) on both servers.

# Separate server-to-server capability for reviewed live Jobs applications and
# Store saved products. Use a NEW shared random secret, at least 32 characters,
# on BOTH servers. Never expose any of these through NEXT_PUBLIC_ or VITE_.
SMAJ_AI_DELEGATION_SECRET=
# `npm start` supervises web and worker against the SAME persistent SQLite path.
# `npm run worker` is also available for development. Both servers must explicitly
# enable SMAJ_PRODUCTION_WRITES_ENABLED=true
# before live actions are accepted. Purchases and Pi payments stay unsupported.
